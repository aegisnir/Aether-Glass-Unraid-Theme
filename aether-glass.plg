<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "aether-glass">
<!ENTITY author    "aegisnir">
<!ENTITY version   "2026.10.31n-dev">
<!ENTITY repo      "https://raw.githubusercontent.com/aegisnir/Aether-Glass-Unraid-Theme">
<!ENTITY src       "&repo;/&version;/source">
<!ENTITY cfg       "/boot/config/plugins/&name;">
<!ENTITY emhttp    "/usr/local/emhttp/plugins/&name;">
<!-- SHA256 of each file in source/ at this version.  tools/release.sh fills these in. -->
<!ENTITY sha_css     "8e458bb4a5c0f9a0e579edcf45f8d1194f8263e71853bf9f40894ff23b3c5b81">
<!ENTITY sha_login   "d4a220066edd20c7d2857b31b8f0cf8f7395603be744355a47984f88ad4cc2cf">
<!ENTITY sha_logging "09b146cd97b72ee8759d8582f711d662b7b32534451737bde96462f9719edc46">
<!ENTITY sha_apply   "0444b7e7f41e4b9703c7ef79ca72ca1b82490577a398b61514b97f9342ab0a00">
<!ENTITY sha_page    "077fa82565d5862318379402bf41a6fac30e07c28fc2bdb7fdcce814ed7a755f">
<!ENTITY sha_icon    "ec8be7110f1cc9d0fe440edfb2d4d3de394dc482519ba26eccbd7a7e2e2d6159">
]>

<PLUGIN name="&name;"
        author="&author;"
        version="&version;"
        pluginURL="&repo;/dev/aether-glass.plg"
        support="https://github.com/aegisnir/Aether-Glass-Unraid-Theme/issues"
        icon="aether-glass.png"
        launch="Settings/AetherGlass"
        min="7.2.0">

<CHANGES>
### 2026.10.31n
- Log and update windows: the title pill has an even 12px gap on all four sides, with the window's corners rounded to match.

### 2026.10.31m
- Log and update windows: the title is a pill again, 8px from the edges, and the window's corners are rounder to match it.
- Search suggestions, right-click menus and dropdown lists: row corners now run parallel to the menu's corners.

### 2026.10.31l
- Apps: the favourite-repository heart on app cards is the theme's rose instead of dark red.
- Log and update windows: the title capsule's corners now run parallel to the window's corners.
- Plugin install and update windows: the button lights up violet when the job ends.

### 2026.10.31k
- Pop-ups are coloured by severity: risky confirms (reboot, shutdown) and errors are rose, OK-only warnings are amber.
- Fixed the confirm button in pop-ups looking darker than Cancel.

### 2026.10.31j
- Array Operation: Start is green, Stop is amber, Reboot and Shutdown are rose, so they stand apart from the everyday buttons.

### 2026.10.31i
- Main page: each section of the device tables (every pool, and parity vs data disks while stopped) is its own rounded glass card, with a clean gap between them.

### 2026.10.31h
- Scroll buttons: side by side in one capsule, always visible (auto-hide removed; Safari didn't update it reliably).

### 2026.10.31g
- Scroll buttons: after clicking down, the up button appears right away instead of looking greyed out (Safari).

### 2026.10.31f
- Scroll buttons hide until you point at them (computers with a mouse; touch screens always show them).

### 2026.10.31e
- Scroll buttons: the capsule always holds both slots; at the top of the page the up button shows dimmed instead of the capsule changing size (Safari didn't resize it reliably).

### 2026.10.31d
- Scroll buttons: the capsule now grows to hold both buttons once you've scrolled down.
- Dev builds now download from their own tag, so they install right after release.

### 2026.10.31c
- Scroll buttons: the capsule is visible against the page, and hovering a button no longer underlines its arrow.

### 2026.10.31b
- Main page: scroll-to-top and scroll-to-end are two round buttons in a glass capsule, clear of the footer.
- Main page: device and slot dropdowns are slimmer and centred in their rows.
- Main page: disk usage bars show their empty track, and a nearly empty bar is a round dot instead of a sliver.
- Header: the array bar no longer shows "offline" in full brand colours when the array is stopped.
- Main page: the blank rows between parity and data disks, and between pools, are now a slim dark divider.
- New dev channel for testing builds (see README).  Main stays the default.

### 2026.10.31a
- The icon on the Plugins page now opens the Aether Glass settings page.

### 2026.10.31
- Docker install and update output page: buttons and the "Command execution" box now match the theme instead of stock orange and grey.

### 2026.10.30a
- New icon: a small glass window with the theme's gradient title bar.

### 2026.10.30
- First release.
</CHANGES>

<!--
  Unofficial theme, not made or endorsed by Lime Technology.

  How this installs:
  1. Downloads the theme files to the flash drive (&cfg;), each checked against its
     SHA256.  Unraid keeps them there and reuses them at every boot, so booting
     without internet still works.
  2. Copies the Settings page and apply.sh into the webGUI folder in RAM (&emhttp;).
  3. Runs apply.sh in boot mode.  It only themes the webGUI if this Unraid version
     has been approved on the Settings page and the kill switch is off.
-->

<FILE Name="&cfg;/aether-glass.css">
<URL>&src;/aether-glass.css</URL>
<SHA256>&sha_css;</SHA256>
</FILE>

<FILE Name="&cfg;/aether-glass-login.css">
<URL>&src;/aether-glass-login.css</URL>
<SHA256>&sha_login;</SHA256>
</FILE>

<FILE Name="&cfg;/aether-glass-logging.css">
<URL>&src;/aether-glass-logging.css</URL>
<SHA256>&sha_logging;</SHA256>
</FILE>

<FILE Name="&cfg;/apply.sh">
<URL>&src;/apply.sh</URL>
<SHA256>&sha_apply;</SHA256>
</FILE>

<FILE Name="&cfg;/AetherGlass.page">
<URL>&src;/AetherGlass.page</URL>
<SHA256>&sha_page;</SHA256>
</FILE>

<FILE Name="&cfg;/aether-glass.png">
<URL>&src;/aether-glass.png</URL>
<SHA256>&sha_icon;</SHA256>
</FILE>

<!-- Shown on the Plugins page -->
<FILE Name="&emhttp;/README.md">
<INLINE>
**Aether Glass**

An unofficial deep-violet frosted-glass theme for the Unraid webGUI.  CSS only: it changes how pages look, nothing else.  Pauses itself after every Unraid update until you approve the new version in Settings -> Aether Glass.
</INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
# Put the Settings page and the apply script in the webGUI folder (RAM, rebuilt every boot)
mkdir -p "&emhttp;"
cp "&cfg;/AetherGlass.page" "&emhttp;/AetherGlass.page"
cp "&cfg;/apply.sh" "&emhttp;/apply.sh"
chmod 755 "&emhttp;/apply.sh"
# Icon for the Plugins list and the Settings grid (Unraid looks in images/)
mkdir -p "&emhttp;/images"
cp "&cfg;/aether-glass.png" "&emhttp;/images/aether-glass.png"

# Theme the webGUI if approved.  Always exit 0: a failed install script makes Unraid
# move the plugin to plugins-error, and a theme problem should never do that.
"&emhttp;/apply.sh" || true

echo ""
echo "Aether Glass is installed.  Open Settings -> Aether Glass to approve this Unraid version and turn it on."
exit 0
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
# Back to stock: apply.sh copies back the untouched files it saved in RAM
[ -x "&emhttp;/apply.sh" ] &amp;&amp; "&emhttp;/apply.sh" --remove

# Delete only this plugin's own files, by name.  rmdir then removes each folder only
# if it is empty, so anything else someone put there is kept.
for f in AetherGlass.page apply.sh README.md; do
    rm -f "&emhttp;/$f"
done
rm -f "&emhttp;/images/aether-glass.png"
rmdir "&emhttp;/images" 2>/dev/null
rmdir "&emhttp;" 2>/dev/null

for f in aether-glass.css aether-glass-login.css aether-glass-logging.css apply.sh AetherGlass.page aether-glass.png approved-version DISABLED; do
    rm -f "&cfg;/$f"
done
rmdir "&cfg;" 2>/dev/null

echo "Aether Glass is removed.  Reload the page to see the stock look."
exit 0
</INLINE>
</FILE>

</PLUGIN>
