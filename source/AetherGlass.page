<?php
/* Aether Glass Settings page.
 * Sections use Unraid's own title bars, so they match every other page in whichever theme
 * is active.  Inside them, the page draws its own larger controls (status readouts, a big
 * switch, the preset panel) in the theme's colours, with Unraid's blue as the fallback.
 * Every button posts to Unraid's own /update.php, which runs apply.sh with fixed
 * arguments.  update.php only runs scripts inside the webGUI folder and quotes the
 * arguments, and apply.sh rejects anything that isn't one of its known options and values.
 * The theme itself is CSS only.  This page is too, except one small script that previews the
 * Appearance colour pickers live and fills them in from a colour scheme; without it the
 * pickers still work and the change shows after Apply.  The preset panel and the choice
 * buttons react to clicks with CSS alone (radio buttons underneath).
 */
$apply  = '/usr/local/emhttp/plugins/aether-glass/apply.sh';
$status = shell_exec(escapeshellarg($apply).' --status 2>&1') ?? '';

// apply.sh --status prints "Name:   value" lines; pick out the ones this page shows
function ag_status($status, $name) {
  return preg_match('/^'.preg_quote($name, '/').':\s*(.*)$/m', $status, $m) ? trim($m[1]) : '';
}
$theme_ver = ag_status($status, 'Theme version') ?: 'unknown';
$unraid    = ag_status($status, 'Unraid version') ?: 'unknown';
$approved  = ag_status($status, 'Approved version');
$kill_on   = ag_status($status, 'Kill switch') === 'ON';
$display   = ag_status($status, 'Display theme');
$themed    = [
  _('Normal pages') => ag_status($status, 'themes/black.css') === 'themed',
  _('Login page')   => ag_status($status, 'default-cases.css') === 'themed',
  _('Log windows')  => ag_status($status, 'logging.htm') === 'themed',
];
$is_approved = $approved !== '' && $approved === $unraid;
$is_on       = !$kill_on && $is_approved && $themed[_('Normal pages')];

// Effects: "Effects:  fast (motion hover, glass panels, glow static)"
preg_match('/^Effects:\s+(\w+) \(motion (\w+), glass (\w+), glow (\w+)\)/m', $status, $fx);
[$preset, $motion, $glass, $glow] = [$fx[1] ?? 'balanced', $fx[2] ?? 'hover', $fx[3] ?? 'all', $fx[4] ?? 'all'];

// Appearance: "Appearance:  bars status, colours accent #10b981 base #02110c" ("colours theme"
// when none are set).  Only known names and #rrggbb values are used; anything else shows the default.
preg_match('/^Appearance:\s+bars (\w+), colours (.*)$/m', $status, $ap);
$bars = in_array($ap[1] ?? '', ['status', 'spectrum'], true) ? $ap[1] : 'status';
// The seven colours, with the theme's own as the starting values (same as the top of aether-glass.css)
$ag_default = ['accent' => '#7c5cff', 'base' => '#08051a', 'panel' => '#140c2e', 'glow' => '#6d28d9',
               'good' => '#14c98e', 'warning' => '#e2aa00', 'critical' => '#fc094c'];
$ag_cols = $ag_default;
preg_match_all('/\b(accent|base|panel|glow|good|warning|critical) (#[0-9a-f]{6})\b/', $ap[2] ?? '', $ag_m, PREG_SET_ORDER);
foreach ($ag_m as [, $k, $v]) $ag_cols[$k] = $v;
// Colour schemes: each one only fills in the pickers.  Status colours stay the theme's own.
$ag_status = array_slice($ag_default, 4);
// One scheme per colour family, each a jewel tone with its own dark background, panel and glow
// of the same hue.  Iris (the default), Ocean, Emerald and Crimson are the originals; the status colours stay
// the theme's own in every scheme.
$ag_schemes = [
  'iris'     => [_('Iris'),     $ag_default],   // the theme's own blue-violet, like an iris petal
  'ocean'    => [_('Ocean'),    ['accent' => '#0ea5e9', 'base' => '#020c17', 'panel' => '#071a2b', 'glow' => '#0369a1'] + $ag_status],
  'lagoon'   => [_('Lagoon'),   ['accent' => '#14b8a6', 'base' => '#01100e', 'panel' => '#072220', 'glow' => '#0f766e'] + $ag_status],
  'emerald'  => [_('Emerald'),  ['accent' => '#10b981', 'base' => '#02110c', 'panel' => '#0a1f18', 'glow' => '#047857'] + $ag_status],
  'citrine'  => [_('Citrine'),  ['accent' => '#eab308', 'base' => '#100c01', 'panel' => '#211a05', 'glow' => '#a16207'] + $ag_status],
  'ember'    => [_('Ember'),    ['accent' => '#f97316', 'base' => '#130701', 'panel' => '#261007', 'glow' => '#c2410c'] + $ag_status],
  'crimson'  => [_('Crimson'),  ['accent' => '#f43f5e', 'base' => '#12040a', 'panel' => '#220a14', 'glow' => '#9f1239'] + $ag_status],
  'sakura'   => [_('Sakura'),   ['accent' => '#f472b6', 'base' => '#14050e', 'panel' => '#260b1c', 'glow' => '#be185d'] + $ag_status],
  'obsidian' => [_('Obsidian'), ['accent' => '#94a3b8', 'base' => '#000000', 'panel' => '#131316', 'glow' => '#334155'] + $ag_status],
];
$ag_scheme_now = 'custom';
foreach ($ag_schemes as $key => [, $cols]) if ($cols == $ag_cols) $ag_scheme_now = $key;
$ag_fields = [
  'accent'   => [_('Accent'),     _('Buttons, toggles, selected tabs, links')],
  'base'     => [_('Background'), _('Behind everything')],
  'panel'    => [_('Panels'),     _('Glass tiles, menus, title bars')],
  'glow'     => [_('Glow'),       _('The aurora behind the glass')],
  'good'     => [_('Healthy'),    _('Running, healthy, low usage')],
  'warning'  => [_('Attention'),  _('Getting full, updating, worth a look')],
  'critical' => [_('Problem'),    _('Full, stopped, errors')],
];

// Hidden fields every form needs
function ag_form_head($apply, $var, $arg0) {
  return '<input type="hidden" name="csrf_token" value="'.htmlspecialchars($var['csrf_token'] ?? '').'">'
       . '<input type="hidden" name="#command" value="'.htmlspecialchars($apply).'">'
       . '<input type="hidden" name="#arg[0]" value="'.htmlspecialchars($arg0).'">';
}
