// ---- Effects ----------------------------------------------------------------------------
// Three effects, lowest level first (four levels for the shimmer and glass, three for glows).
// The level number is how many sections of that effect's bar are filled.  Visuals = all three
// bars added up (3 to 11 sections).  Speed is NOT the mirror image: each level has its own cost, measured by
// benchmarking all 27 combinations twice on the Dashboard (Safari, 120 Hz).  Holographic on
// every title: scrolling 48 -> 32 fps and about 12x the stutters; on hover it costs nothing
// measurable.  Frosted glass: about 15-20 fps less while idle, almost all of it from the big
// panels (Panels and Everything cost nearly the same).  Glows: no measurable cost.  9 = full speed.
// Page titles and Menus were added later and not benchmarked; their cost is inferred: a few
// always-moving titles against ~37 for Every title, and only the menu bar's blur always on
// screen against every panel for Panels.
// Keys match apply.sh (motion = the holographic effect).
$ag_fx = [
  'motion' => [_('Holographic'), [
      'still'      => [_('Still'),        _('Titles hold a still frame of the holographic shimmer.')],
      'hover'      => [_('On hover'),     _('The shimmer moves on the tile you point at.')],
      'titles'     => [_('Page titles'),  _('The section titles on each page shimmer all the time; Dashboard tiles still on hover.')],
      'everywhere' => [_('Every title'),  _('The shimmer moves on every title at once.')]]],
  'glass'  => [_('Frosted glass'), [
      'off'        => [_('Off'),          _('Solid panels, no blur.')],
      'menus'      => [_('Menus'),        _('Glass only on the menu bar, dropdowns, dialogs and tooltips; solid panels.')],
      'panels'     => [_('Panels'),       _('Blur on panels; small buttons get a plain fill.')],
      'all'        => [_('Everything'),   _('Blur behind every panel, button and menu.')]]],
  'glow'   => [_('Glows'), [
      'off'        => [_('Off'),          _('No glows.')],
      'static'     => [_('Still things'), _('Glows on things that sit still; none on live bars and numbers.')],
      'all'        => [_('Everywhere'),   _('Soft glows on every coloured bar, ring and status.')]]],
];
$ag_now = ['motion' => $motion, 'glass' => $glass, 'glow' => $glow];
$themed_count = count(array_filter($themed));
// Named mixes (the presets apply.sh knows); any other mix is Custom
$ag_names = ['everywhere|all|all' => _('Vivid'), 'hover|all|all' => _('Balanced'),
             'hover|menus|static' => _('Light'), 'still|off|off' => _('Minimal')];

// One effect: label, the line describing the picked level, and a 3-section bar of radio buttons
function ag_level($key, $fx, $now) {
  [$label, $levels] = $fx;
  $html = '<div class="ag-fxrow"><div class="ag-fxname"><b>'.$label.'</b>';
  foreach ($levels as $val => [$name, $desc]) $html .= '<span class="ag-desc" data-for="ag-'.$key.'-'.$val.'">'.$desc.'</span>';
  $icon = ['motion' => 'fa-magic', 'glass' => 'fa-snowflake-o', 'glow' => 'fa-sun-o'][$key];
  // a small icon on the left and a large one on the right mean less / more, like Apple's sliders
  $html .= '</div><div class="ag-sl"><i class="fa '.$icon.' ag-less" aria-hidden="true"></i>'
         . '<div class="ag-lvl"><span class="ag-track"><span class="ag-fill"></span><span class="ag-knob"></span></span>';
  // Stop k sits at k / (levels - 1) along the full-width bar: a tick under the line marks it,
  // and its word sits under the tick (first word left-aligned, last right-aligned).  Each
  // click area covers the stretch of bar nearest its stop.
  $last = count($levels) - 1; $k = 0;
  foreach ($levels as $val => [$name, $desc]) {
    $at = round($k / $last * 100, 3);
    $from = round(max(0, ($k - 0.5) / $last) * 100, 3); $to = round(min(1, ($k + 0.5) / $last) * 100, 3);
    $align = $k === 0 ? 'start' : ($k === $last ? 'end' : 'mid');
    $html .= '<i class="ag-tick" style="left: '.$at.'%"></i>';
    $saved = ($val === $now) ? ' class="ag-saved" checked' : '';
    $html .= '<input type="radio" id="ag-'.$key.'-'.$val.'" name="#arg['.(['motion'=>1,'glass'=>2,'glow'=>3][$key]).']" value="'.$key.'='.$val.'"'.$saved.'>'
           . '<label for="ag-'.$key.'-'.$val.'" class="ag-'.$align.'" style="left: '.$from.'%; width: '.round($to - $from, 3).'%"><span class="ag-cap">'
           . ($val === $now ? '<span class="ag-applied" title="'._('Applied').'">&check;</span>' : '').$name.'</span></label>';
    $k++;
  }
  return $html.'</div><i class="fa '.$icon.' ag-more" aria-hidden="true"></i></div></div>';
}

// CSS that follows the picks (no script): fill each bar up to the picked level, show that
// level's description, and work out the Visuals / Speed bars and the mix's name.
function ag_fx_css($fx, $names) {
  $css = '';
  foreach ($fx as $key => [$label, $levels]) {
    $vals = array_keys($levels);
    foreach ($vals as $n => $val) {
      $css .= ".ag-fx:has(#ag-$key-$val:checked) .ag-desc[data-for=\"ag-$key-$val\"] { display: block; }\n";
      $x = round($n / (count($vals) - 1) * 100, 3);   // lowest level = empty bar, knob at the start
      $css .= ".ag-lvl:has(#ag-$key-$val:checked) .ag-fill { width: $x%; }\n";
      $knob = "clamp(0rem, calc($x% - 0.9rem), calc(100% - 1.8rem))";   // centred on the stop, kept inside the bar
      $css .= ".ag-lvl:has(#ag-$key-$val:checked) .ag-knob { left: $knob; }\n";
      // pointing at a level: the knob glides there, showing where a click lands
      // (doubled class so it outranks the "picked level" rule above, whatever the order)
      $css .= ".ag-lvl.ag-lvl:has(label[for=\"ag-$key-$val\"]:hover) .ag-knob { left: $knob; }\n";
    }
  }
  $cost = ['motion' => ['still' => 0, 'hover' => 0, 'titles' => 1, 'everywhere' => 4],
           'glass'  => ['off' => 0, 'menus' => 1, 'panels' => 2, 'all' => 3],
           'glow'   => ['off' => 0, 'static' => 0, 'all' => 0]];
  [$m, $g, $w] = array_values(array_map('array_keys', array_column($fx, 1)));
  foreach ($m as $a => $mv) foreach ($g as $b => $gv) foreach ($w as $c => $wv) {
    $sum = $a + $b + $c + 3;                       // 3 to 11 filled sections
    $speed = 9 - $cost['motion'][$mv] - $cost['glass'][$gv] - $cost['glow'][$wv];   // 2 to 9 (Vivid 2, Balanced 6, Light 7, Minimal 9)
    $sel = ".ag-fx:has(#ag-motion-$mv:checked):has(#ag-glass-$gv:checked):has(#ag-glow-$wv:checked)";
    $v = round($sum / 11 * 100); $sp = round($speed / 9 * 100);
    $css .= "$sel .ag-ring.vis { --p: $v; --n: $v; }\n$sel .ag-ring.spd { --p: $sp; --n: $sp; }\n";
    $name = $names["$mv|$gv|$wv"] ?? null;
    $css .= ".ag-fx:not(:has(.ag-lvl input:checked:not(.ag-saved))):has(#ag-motion-$mv:checked):has(#ag-glass-$gv:checked):has(#ag-glow-$wv:checked)"
          . " .ag-mix [data-mix=\"".($name ? "$mv|$gv|$wv" : 'custom')."\"] { display: inline; }\n";
  }
  // Any change not applied yet reads Custom, even if it happens to match a preset: the name
  // shows what is applied, so an edit to Vivid never looks like it turned into Minimal.
  $css .= ".ag-fx:has(.ag-lvl input:checked:not(.ag-saved)) .ag-mix [data-mix=\"custom\"] { display: inline; }\n";
  return $css;
}
