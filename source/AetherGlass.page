   middle is a CSS counter fed by the same value, so no script is needed. */
.ag-rings { display: flex; gap: 3.2rem; margin-top: 1.8rem; }
.ag-gauge { display: grid; justify-items: center; gap: 0.8rem; }
.ag-ring { position: relative; width: 11rem; height: 11rem; display: grid; place-items: center; }
.ag-ring { --t: 1.1rem; --r: calc(5.5rem - var(--t) / 2); --a: calc(var(--p) * 3.6deg); }   /* thickness, radius to the middle of the band, fill angle */
.ag-ring::before { content: ""; position: absolute; inset: 0; border-radius: 50%;
  background:
    radial-gradient(circle at calc(50% + var(--r) * sin(var(--a))) calc(50% - var(--r) * cos(var(--a))),
      var(--ag-accent) calc(var(--t) / 2 - 0.5px), transparent calc(var(--t) / 2)),
    radial-gradient(circle at 50% calc(var(--t) / 2), var(--aether-cyan, oklch(from var(--aether-accent, #7c5cff) calc(l - 0.0541) calc(c * 0.5556) calc(h - 22.80))) calc(var(--t) / 2 - 0.5px), transparent calc(var(--t) / 2)),
    conic-gradient(var(--aether-cyan, oklch(from var(--aether-accent, #7c5cff) calc(l - 0.0541) calc(c * 0.5556) calc(h - 22.80))) 0%, var(--ag-accent) calc(var(--p) * 1%),
      color-mix(in srgb, var(--ag-accent) 20%, oklch(from var(--aether-panel, #140c2e) calc(l + 0.0014) calc(c * 0.9216) calc(h + 2.04))) calc(var(--p) * 1%) 100%);
  -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - var(--t)), #000 calc(100% - var(--t) + 1px));
  mask: radial-gradient(farthest-side, transparent calc(100% - var(--t)), #000 calc(100% - var(--t) + 1px)); }
/* Each ring animates its own value, so changing a level sweeps the ring and counts the
   number up or down.  (Animating a value inherited from the whole section made Safari
   restart it from 0 on every click.)  Registered so the browser can animate a number. */
@property --p { syntax: "<integer>"; inherits: true; initial-value: 0; }
/* The number reads --n, a plain copy that changes instantly: Safari shows 0 for a counter
   whose value is mid-animation, so only the ring (--p) animates. */
.ag-ring { transition: --p 0.5s cubic-bezier(0.4, 0, 0.2, 1); counter-reset: ag-n var(--n); }
@media (prefers-reduced-motion: reduce) { .ag-ring { transition: none; } }
.ag-ring::after { content: counter(ag-n) "%"; font-size: 2.2rem; font-weight: 700; }
.ag .ag-fine { margin: 1.4rem 0 0; font-size: 1.15rem; line-height: 1.5; color: var(--ag-dim); max-width: 25rem; }   /* the width of the two rings */
.ag-gauge > b { font-size: 1.15rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ag-dim); font-weight: 600; }

/* Apply turns green while something is picked that isn't applied yet */
.ag form:has(input[type="radio"]:checked:not(.ag-saved)) input[type="submit"] {
  color: oklch(from var(--aether-good, #14c98e) calc(l - 0.5706) calc(c * 0.1652) calc(h + 3.50)); background: linear-gradient(180deg, oklch(from var(--aether-good, #14c98e) calc(l + 0.0652) calc(c * 1.0029) calc(h - 3.50)) 0, var(--aether-good, #14c98e) 55%, oklch(from var(--aether-good, #14c98e) calc(l - 0.0981) calc(c * 0.8653) calc(h + 0.29)) 100%);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 0 14px -2px rgb(from var(--aether-good, #14c98e) r g b / 0.6); }
.ag code { font-size: 1.15rem; }
/* Benchmark: a plain HTML disclosure (no script) holding the steps and the code to copy */
.ag-bench summary { cursor: pointer; color: oklch(from var(--aether-accent, #7c5cff) calc(l + 0.2121) calc(c * 0.4405) calc(h + 7.37)); font-weight: 600; margin-bottom: 1rem; }
.ag-bench ol { margin: 0 0 1.2rem; padding-left: 2rem; color: var(--ag-dim); max-width: 90rem; }
.ag-bench li { margin-bottom: 0.6rem; }
.ag .ag-code { display: block; width: 100%; max-width: 90rem; font: 1.15rem/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  white-space: pre; overflow: auto; resize: vertical; }
/* preset dropdown: small, on one line; Apply goes green when a different preset is picked */
.ag-preset { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; margin-top: 1.8rem; padding-top: 1.4rem; border-top: 1px solid var(--ag-line); max-width: 62rem; }
.ag-preset label { color: var(--ag-dim); }
.ag .ag-preset select { width: auto; min-width: 16rem; max-width: 24rem; margin: 0; }
.ag form.ag-preset:has(option:checked:not(.ag-saved)) input[type="submit"] {
  color: oklch(from var(--aether-good, #14c98e) calc(l - 0.5706) calc(c * 0.1652) calc(h + 3.50)); background: linear-gradient(180deg, oklch(from var(--aether-good, #14c98e) calc(l + 0.0652) calc(c * 1.0029) calc(h - 3.50)) 0, var(--aether-good, #14c98e) 55%, oklch(from var(--aether-good, #14c98e) calc(l - 0.0981) calc(c * 0.8653) calc(h + 0.29)) 100%);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 0 14px -2px rgb(from var(--aether-good, #14c98e) r g b / 0.6); }
/* ---- Appearance: a picture for each choice, like macOS's Light / Dark picker ----
   Each option is a radio button drawn as a small glass card showing three sample bars
   (about 30%, 75% and 95%) in that style.  The samples carry their own colours, so they
   look right even while the theme is off.  The colours are the theme's 1% table at those
   values (see "Usage bars" in aether-glass.css). */
.ag-picks { display: flex; flex-wrap: wrap; gap: 1.6rem; margin: 1.4rem 0 0.6rem; }
.ag-pick input { position: absolute; opacity: 0; pointer-events: none; }
.ag-pick label { display: grid; gap: 0.8rem; justify-items: center; cursor: pointer; }
.ag-pickcard { display: grid; gap: 0.9rem; width: 19rem; padding: 1.5rem 1.6rem; border-radius: 1.4rem;
  background: oklch(from var(--aether-panel, #140c2e) calc(l + 0.0154) calc(c * 1.0183) calc(h - 2.65) / 0.7); box-shadow: 0 0 0 1px var(--ag-line); transition: box-shadow 0.2s; }
.ag-pick label:hover .ag-pickcard { box-shadow: 0 0 0 1px oklch(from var(--aether-accent, #7c5cff) calc(l + 0.2331) calc(c * 0.3943) calc(h + 5.14) / 0.35); }
.ag-pick input:checked + label .ag-pickcard { box-shadow: 0 0 0 2px var(--ag-accent), 0 0 18px -4px var(--ag-accent); }
.ag-pick input:focus-visible + label .ag-pickcard { outline: 2px solid var(--ag-accent); outline-offset: 4px; }
.ag-pick .ag-cap2 { font-size: 1.3rem; color: oklch(from var(--aether-accent, #7c5cff) calc(l + 0.1942) calc(c * 0.1747) calc(h - 10.32)); }
.ag-pick input:checked + label .ag-cap2 { color: #fff; font-weight: 600; }
.ag-sb { position: relative; height: 0.9rem; border-radius: 999px; overflow: hidden; container-type: inline-size; }
.ag-sb > i { position: absolute; inset: 0 auto 0 0; border-radius: 999px; }
.ag-sb.s30 > i { width: 30%; } .ag-sb.s74 > i { width: 74%; } .ag-sb.s94 > i { width: 94%; }
/* The samples read the theme's own bar colours (its 1% table and status colours), so they always
   match the real bars.  The fallbacks are the theme's defaults, for when the theme is off. */
.ag-pick { --g: var(--aether-good, #14c98e); --w: var(--aether-warning, #e2aa00); --r: var(--aether-critical, #fc094c); --tb: #150d2c; }
/* Status: one colour per bar, a little deeper at the start, on a dim track of that colour */
.ag-status .s30 { --c: var(--aether-bar-30, color-mix(in srgb, #14c98e 58.33%, #e2aa00)); }
.ag-status .s74 { --c: var(--aether-bar-74, color-mix(in srgb, #e2aa00 92.86%, #fc094c)); }
.ag-status .s94 { --c: var(--aether-bar-94, color-mix(in srgb, #e2aa00 21.43%, #fc094c)); }
.ag-status .ag-sb { background: color-mix(in srgb, var(--c) 20%, var(--tb)); }
.ag-status .ag-sb > i { background: linear-gradient(90deg in oklch, oklch(from var(--c) calc(l - 0.12) calc(c * 1.08) calc(h - 18)), oklch(from var(--c) calc(l + 0.04) c h)); }
/* Spectrum: one Healthy-to-Problem gradient across the whole bar, revealed by the fill */
.ag-spectrum .ag-sb { background: linear-gradient(90deg, color-mix(in srgb, var(--g) 20%, var(--tb)), color-mix(in srgb, var(--w) 20%, var(--tb)) 72%, color-mix(in srgb, var(--r) 20%, var(--tb))); }
.ag-spectrum .ag-sb > i { background: linear-gradient(90deg, var(--g), var(--w) 72%, var(--r));
  background-size: 100cqw 100%; background-repeat: no-repeat; }
/* ---- Appearance: colours.  One row per colour, like a System Settings list: name and a short
   hint on the left, the picker and its hex value on the right.  The colour schemes above the
   list only fill in the pickers; they need the small script at the end of the page, so they
   stay hidden until it runs (the pickers work without it). */
.ag-schemes { display: none; flex-wrap: wrap; gap: 1.6rem; margin: 1.2rem 0 0.4rem; }
.ag.ag-js .ag-schemes { display: flex; }
/* The theme (and Unraid) style every <button> as a pill; these are swatches, so undo that.
   !important because the button rules are far more specific than anything sensible here. */
.ag .ag-schemes .ag-scheme, .ag .ag-schemes .ag-scheme:hover, .ag .ag-schemes .ag-scheme:focus {
  all: unset; display: grid !important; justify-items: center; gap: 0.6rem; cursor: pointer; font-size: 1.2rem; color: oklch(from var(--aether-accent, #7c5cff) calc(l + 0.1942) calc(c * 0.1747) calc(h - 10.32));
  background: none !important; box-shadow: none !important; border: 0 !important; padding: 0 !important; margin: 0 !important;
  min-width: 0 !important; height: auto !important; animation: none !important; text-transform: none !important; }
/* Each scheme's icon: a gem cut in half.  Top left, its dark background fading into its panel
   colour; bottom right, its glow rising into the accent and a lighter accent at the edge.  Along
   the cut, a bright line in the scheme's own brand gradient (the cyan, accent and pink of the
   titles and logo, turned to match the accent, the same way the theme works them out). */
.ag-scheme i { position: relative; overflow: hidden; width: 4.2rem; height: 4.2rem; border-radius: 50%;
  box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.14);
  background: linear-gradient(135deg, var(--gem-b) 0, var(--gem-p) 50%, var(--gem-g) 50%, var(--gem-a) 80%, oklch(from var(--gem-a) calc(l + 0.12) calc(c * 0.8) h) 100%); }
.ag-scheme i::after { content: ""; position: absolute; left: -25%; top: 50%; width: 150%; height: 0.3rem; margin-top: -0.15rem; transform: rotate(-45deg);
  background: linear-gradient(90deg, oklch(from var(--gem-a) calc(l + 0.2451) calc(c * 0.6334) calc(h - 76.92)), var(--gem-a), oklch(from var(--gem-a) calc(l + 0.0781) calc(c * 1.0353) calc(h + 70.58)));
  box-shadow: 0 0 0.6rem oklch(from var(--gem-a) l c h / 0.8); }
.ag-scheme[aria-pressed="true"] { color: #fff; font-weight: 600; }
.ag-scheme[aria-pressed="true"] i { box-shadow: 0 0 0 2px #0b0b10, 0 0 0 4px #fff; }
.ag-scheme:focus-visible i { outline: 2px solid var(--ag-accent); outline-offset: 4px; }
.ag-cols { max-width: 62rem; margin-top: 1rem; }
/* The pickers always show, so any scheme can be fine-tuned.  When the colours match no scheme,
   no scheme is highlighted. */
.ag-colhead { font-size: 1.1rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ag-dim); margin: 1.6rem 0 0.2rem; }
.ag-col { display: grid; grid-template-columns: 1fr auto; gap: 1.2rem; align-items: center; padding: 0.9rem 0; border-bottom: 1px solid var(--ag-line); }
.ag-col label b { display: block; font-size: 1.35rem; }
.ag-col label small { color: var(--ag-dim); font-size: 1.15rem; }
.ag-col .ag-warn2 { grid-column: 1 / -1; margin-top: -0.4rem; font-size: 1.15rem; color: oklch(from var(--aether-warning, #e2aa00) calc(l + 0.0683) calc(c * 0.9986) calc(h + 14.35)); }
.ag-swatch { display: inline-flex; align-items: center; gap: 0.8rem; }
.ag-swatch code { font: 1.2rem ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--ag-dim); min-width: 6.4rem; }
/* Safari draws its own colour well with shading that washes the colour out, so the circle is
