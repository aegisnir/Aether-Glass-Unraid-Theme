  background:
    radial-gradient(circle at calc(50% + var(--r) * sin(var(--a))) calc(50% - var(--r) * cos(var(--a))),
      var(--ag-accent) calc(var(--t) / 2 - 0.5px), transparent calc(var(--t) / 2)),
    radial-gradient(circle at 50% calc(var(--t) / 2), var(--aether-cyan, #486dba) calc(var(--t) / 2 - 0.5px), transparent calc(var(--t) / 2)),
    conic-gradient(var(--aether-cyan, #486dba) 0%, var(--ag-accent) calc(var(--p) * 1%),
      color-mix(in srgb, var(--ag-accent) 20%, #150d2c) calc(var(--p) * 1%) 100%);
  -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - var(--t)), #000 calc(100% - var(--t) + 1px));
  mask: radial-gradient(farthest-side, transparent calc(100% - var(--t)), #000 calc(100% - var(--t) + 1px)); }
/* Each ring animates its own value, so changing a level sweeps the ring and counts the
   number up or down.  (Animating a value inherited from the whole section made Safari
   restart it from 0 on every click.)  Registered so the browser can animate a number. */
