<?php
/* Aether Glass Settings page.
 * Sections use Unraid's own title bars, so they match every other page in whichever theme
 * is active.  Inside them, the page draws its own larger controls (status readouts, a big
 * switch, the preset panel) in the theme's colours, with Unraid's blue as the fallback.
 * Every button posts to Unraid's own /update.php, which runs apply.sh with fixed
 * arguments.  update.php only runs scripts inside the webGUI folder and quotes the
 * arguments, and apply.sh rejects anything that isn't one of its known options and values.
 * No JavaScript: the theme is CSS only, and so is this page.  The preset panel and the
 * choice buttons react to clicks with CSS alone (radio buttons underneath).
 */
$apply  = '/usr/local/emhttp/plugins/aether-glass/apply.sh';
$status = shell_exec(escapeshellarg($apply).' --status 2>&1') ?? '';

// apply.sh --status prints "Name:   value" lines; pick out the ones this page shows
function ag_status($status, $name) {
  return preg_match('/^'.preg_quote($name, '/').':\s*(.*)$/m', $status, $m) ? trim($m[1]) : '';
}
$theme_ver = ag_status($status, 'Theme version') ?: 'unknown';
$unraid    = ag_status($status, 'Unraid version') ?: 'unknown';
$approved  = ag_status($status, 'Approved version');
$kill_on   = ag_status($status, 'Kill switch') === 'ON';
$display   = ag_status($status, 'Display theme');
$themed    = [
  _('Normal pages') => ag_status($status, 'themes/black.css') === 'themed',
  _('Login page')   => ag_status($status, 'default-cases.css') === 'themed',
  _('Log windows')  => ag_status($status, 'logging.htm') === 'themed',
];
$is_approved = $approved !== '' && $approved === $unraid;
$is_on       = !$kill_on && $is_approved && $themed[_('Normal pages')];

// Effects: "Effects:  fast (motion hover, glass panels, glow static)"
preg_match('/^Effects:\s+(\w+) \(motion (\w+), glass (\w+), glow (\w+)\)/m', $status, $fx);
[$preset, $motion, $glass, $glow] = [$fx[1] ?? 'balanced', $fx[2] ?? 'hover', $fx[3] ?? 'all', $fx[4] ?? 'all'];

// Hidden fields every form needs
function ag_form_head($apply, $var, $arg0) {
  return '<input type="hidden" name="csrf_token" value="'.htmlspecialchars($var['csrf_token'] ?? '').'">'
       . '<input type="hidden" name="#command" value="'.htmlspecialchars($apply).'">'
       . '<input type="hidden" name="#arg[0]" value="'.htmlspecialchars($arg0).'">';
}
